# VERONIKA AI Desktop - Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider: openai | google | groq | openrouter | omniroute | ollama
AI_PROVIDER=openai

# Free-first policy: when true, paid providers are never used silently
AI_FREE_ONLY=false

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini Configuration
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Groq Configuration (free tier)
GROQ_API_KEY=

# OpenRouter Configuration (free-tier models available)
OPENROUTER_API_KEY=

# OmniRoute (local gateway) -- no API key required
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_MODEL=kr/qwen3-coder-next

# Ollama (local) -- no API key required
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# Voice Settings
TTS_ENABLED=true
TTS_VOICE=default
TTS_SPEED=150
STT_LANGUAGE=en-US

# Wake Word (requires Picovoice access key)
WAKE_WORD_ENABLED=false
PICOVOICE_ACCESS_KEY=

# General
LANGUAGE=en
STARTUP_WITH_WINDOWS=false
FLOATING_WINDOW=false
SCREENSHOT_CONFIRM=true
